{
  "manifest_version": 2,
  "name": "Hybrid: Mild Color Blind & Short-Sighted Theme",
  "version": "1.0",
  "description": "A deuteranopia-friendly theme with larger text for users with mild color blindness and short-sightedness.",
  "theme": {
    "colors": {
      "frame": [180, 200, 255], 
      "toolbar": [160, 180, 230],
      "toolbar_text": [50, 50, 50],
      "tab_text": [50, 50, 50],
      "tab_background_text": [255, 255, 255],
      "bookmark_text": [50, 50, 50],
      "button_background": [255, 152, 0],
      "button_text": [255, 255, 255],
      "ntp_background": [245, 245, 245],
      "ntp_text": [51, 51, 51],
      "ntp_header": [255, 204, 0],
      "ntp_link": [0, 102, 204],
      "ntp_section": [245, 245, 245]
    },
    "properties": {
      "ntp_background_color": [245, 245, 245],
      "ntp_text_color": [51, 51, 51],
      "ntp_button_color": [0, 102, 204],  
      "ntp_logo_color": [255, 204, 0], 
      "ntp_searchbox_background": [255, 255, 255], 
      "ntp_searchbox_text_color": [51, 51, 51],  
      "ntp_searchbox_border": [0, 102, 204]  
    }
  },
  "permissions": [
    "activeTab"
  ]
}
