{
  "manifest_version": 2,
  "name": "Distance Vision Impairment Theme",
  "version": "1.0",
  "description": "A Chrome theme with larger text for users with distance vision impairment.",
  "theme": {
    "colors": {
      "frame": [200, 200, 200], 
      "toolbar": [180, 180, 180],
      "toolbar_text": [0, 0, 0],
      "tab_text": [0, 0, 0],
      "tab_background_text": [255, 255, 255],
      "bookmark_text": [0, 0, 0],
      "button_background": [0, 153, 204],
      "button_text": [255, 255, 255],
      "ntp_background": [250, 250, 250],
      "ntp_text": [0, 0, 0],
      "ntp_header": [0, 153, 204],
      "ntp_link": [0, 76, 153],
      "ntp_section": [230, 230, 230]
    },
    "properties": {
      "ntp_background_color": [250, 250, 250],
      "ntp_text_color": [0, 0, 0],
      "ntp_button_color": [0, 153, 204],  
      "ntp_logo_color": [0, 153, 204], 
      "ntp_searchbox_background": [255, 255, 255], 
      "ntp_searchbox_text_color": [0, 0, 0],  
      "ntp_searchbox_border": [0, 153, 204]  
    }
  },
  "permissions": [
    "activeTab"
  ]
}
