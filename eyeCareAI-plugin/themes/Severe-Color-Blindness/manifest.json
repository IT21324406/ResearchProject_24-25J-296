{
  "manifest_version": 2,
  "name": "Severe Color Blindness Theme",
  "version": "1.0",
  "description": "A high-contrast monochrome theme for users with severe color blindness.",
  "theme": {
    "colors": {
      "frame": [0, 0, 0], 
      "toolbar": [50, 50, 50],
      "toolbar_text": [255, 255, 255],
      "tab_text": [255, 255, 255],
      "tab_background_text": [255, 255, 255],
      "bookmark_text": [255, 255, 255],
      "button_background": [0, 0, 0],
      "button_text": [255, 255, 255],
      "ntp_background": [0, 0, 0],
      "ntp_text": [255, 255, 255],
      "ntp_header": [100, 100, 100],
      "ntp_link": [200, 200, 200],
      "ntp_section": [50, 50, 50]
    },
    "properties": {
      "ntp_background_color": [0, 0, 0],
      "ntp_text_color": [255, 255, 255],
      "ntp_button_color": [200, 200, 200],  
      "ntp_logo_color": [255, 255, 255], 
      "ntp_searchbox_background": [50, 50, 50], 
      "ntp_searchbox_text_color": [255, 255, 255],  
      "ntp_searchbox_border": [255, 255, 255]  
    }
  },
  "permissions": [
    "activeTab"
  ]
}
