{
  "manifest_version": 3,
  "name": "Medium Summary Generator",
  "version": "1.0",
  "description": "Summarizes Medium articles using AI",
  "permissions": ["activeTab", "scripting", "identity", "identity.email"],
  "host_permissions": ["https://medium.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
