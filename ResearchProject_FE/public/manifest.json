{
  "manifest_version": 3,
  "name": "Reactive Web",
  "version": "1.0",
  "description": "Software User Interface Personalization for Medium Articles",
  "permissions": [
    "activeTab",
    "scripting",
    "identity",
    "identity.email",
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://medium.com/*",
    "https://it21324406-researchproject-be.onrender.com/*",
    "https://it21324406-24-25j-296-it21215360-be-q979.onrender.com/*",
    "https://*.onrender.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [{
    "resources": ["mindmap.html", "mindmap.js", "landing.html", "landing.js", "second.html", "second.js"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_popup": "landing.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
