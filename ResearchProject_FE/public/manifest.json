{
  "manifest_version": 3,
  "name": "Medium Summary Generator",
  "version": "1.0",
  "description": "Summarizes Medium articles using AI",
  "permissions": [
    "activeTab",
    "scripting",
    "identity",
    "identity.email",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://medium.com/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [{
    "resources": ["mindmap.html", "mindmap.js", "landing.html", "landing.js"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_popup": "landing.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
